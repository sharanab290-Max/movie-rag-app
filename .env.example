# Neo4j Database Connection
# For Neo4j Desktop or local Docker: bolt://localhost:7687
# For Neo4j AuraDB: neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Gemini LLM API Key (optional - embedded heuristic engine active if omitted)
GEMINI_API_KEY=
